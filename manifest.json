{
  "manifest_version": 3,
  "name": "Focus & Save — Smart Reader & Bookmark Manager",
  "version": "1.0.0",
  "description": "Turn distracting webpages into clean reading experiences and manage bookmarks locally.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}